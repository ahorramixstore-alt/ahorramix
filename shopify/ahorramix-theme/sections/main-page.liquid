<section class="container narrow listing" {{ section.shopify_attributes }}>
  <header class="page-head">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="page-title">{{ page.title }}</h1>
  </header>
  <div class="rte">{{ page.content }}</div>
</section>

{% schema %}
{
  "name": "Contenido de la página",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "Antetítulo (opcional)" }]
}
{% endschema %}
