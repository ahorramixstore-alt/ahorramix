<section class="container trust" {{ section.shopify_attributes }}>
  <div class="trust__grid">
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}
      {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }} {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} class="trust__item" {{ block.shopify_attributes }}>
        <span class="trust__icon">{% render 'icon', name: block.settings.icon, size: 20 %}</span>
        <span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></span>
      </{{ tag }}>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Ventajas",
  "class": "section-trust",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Ventaja",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "default": "truck", "options": [
          { "value": "truck", "label": "Camión" }, { "value": "card", "label": "Tarjeta" }, { "value": "return", "label": "Devolución" },
          { "value": "package", "label": "Paquete" }, { "value": "shield", "label": "Escudo" }, { "value": "heart", "label": "Corazón" }, { "value": "star", "label": "Estrella" }, { "value": "mail", "label": "Email" }
        ] },
        { "type": "text", "id": "title", "label": "Título", "default": "Plazo visible" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Entrega estimada en cada ficha" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Ventajas", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
