<section class="container narrow block-space rich" style="--bg: {{ section.settings.bg }};" {{ section.shopify_attributes }}>
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {%- if section.settings.title != blank -%}<h2 class="sec-title">{{ section.settings.title }}</h2>{%- endif -%}
  {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
  {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--dark">{{ section.settings.button_label }}</a>{%- endif -%}
</section>

{% schema %}
{
  "name": "Texto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "title", "label": "Título", "default": "Título" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Escribe aquí tu texto.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón · texto" },
    { "type": "url", "id": "button_link", "label": "Botón · enlace" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "rgba(0,0,0,0)" }
  ],
  "presets": [{ "name": "Texto" }]
}
{% endschema %}
