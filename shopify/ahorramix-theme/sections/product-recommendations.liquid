<section class="container block-space" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}" {{ section.shopify_attributes }}>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="sec-head"><h2 class="sec-title">{{ section.settings.title }}</h2></div>
    <div class="rail">
      {%- for p in recommendations.products -%}{% render 'product-card', product: p, class: 'rail__item' %}{%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Productos relacionados",
  "class": "section-recommendations",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "También te puede gustar" },
    { "type": "range", "id": "limit", "label": "Número de productos", "min": 2, "max": 10, "step": 1, "default": 8 }
  ]
}
{% endschema %}
