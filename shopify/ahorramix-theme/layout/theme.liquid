<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}

    {%- if settings.use_brand_fonts -%}
      <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
      <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
      <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    {%- endif -%}

    <style>
      :root {
        --am-bg: {{ settings.color_bg }};
        --am-bg-2: {{ settings.color_bg_2 }};
        --am-ink: {{ settings.color_ink }};
        --am-ink-2: {{ settings.color_ink_2 }};
        --am-black: {{ settings.color_black }};
        --am-orange: {{ settings.color_orange }};
        --am-yellow: {{ settings.color_yellow }};
        --am-price: {{ settings.color_price }};
        --am-emerald: {{ settings.color_emerald }};
        --am-dark: {{ settings.color_footer }};
        --am-line: #e2e4e9;
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <div class="toast" id="CartToast" role="status" aria-live="polite" hidden></div>
    <script>
      window.amRoutes = { cartAdd: "{{ routes.cart_add_url }}", cart: "{{ routes.cart_url }}" };
      window.amStrings = { added: {{ 'cart.added' | t | json }}, error: {{ 'cart.error' | t | json }}, view: {{ 'cart.view' | t | json }} };
    </script>
  </body>
</html>
