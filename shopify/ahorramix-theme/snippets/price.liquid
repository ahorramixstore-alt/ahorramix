{%- comment -%} Precio con oferta. Uso: {% render 'price', product: product %} o con variant {%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  if variant == blank
    assign price = product.price_min
    assign compare = product.compare_at_price_min
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
    assign save = compare | minus: price | money
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}{% if size %} price--{{ size }}{% endif %}">
  <span class="price__now">{% if variant == blank and product.price_varies %}{{ 'products.from' | t }} {% endif %}{{ price | money }}</span>
  {%- if on_sale -%}
    <s class="price__was">{{ compare | money }}</s>
    {%- if show_save -%}<span class="price__save">{{ 'products.save' | t: amount: save }}</span>{%- endif -%}
  {%- endif -%}
</div>
